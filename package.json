{
  "name": "obdii-monorepo",
  "version": "1.0.0",
  "description": "ELM327 OBD2 / KWP2000 diagnostics: shared core plus terminal, web server, PWA and Android apps",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node index.js",
    "cli": "npm start -w @obdii/cli",
    "server": "npm start -w @obdii/server --",
    "test": "npm test --workspaces --if-present",
    "pwa": "npm start -w @obdii/pwa",
    "pwa:build": "npm run build -w @obdii/pwa",
    "esp32:mock": "node firmware/esp32-elm327/tools/mock-server.mjs"
  },
  "author": "edwinspire",
  "license": "ISC"
}
